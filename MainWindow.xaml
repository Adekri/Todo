<Window x:Class="todo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:todo"
        mc:Ignorable="d"
        Title="Todo List" Height="440" Width="745" MinHeight="440" MinWidth="745"
        ResizeMode="CanResize" Background="#F0F0F0"
        SizeChanged="Window_SizeChanged"
        Icon="/ikona.ico">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <!-- První řádek pro seznam úkolů -->
            <RowDefinition Height="*"/>
            <!-- Druhý řádek pro přidání úkolu -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ListView -->
        <GroupBox Header="Tasks" Margin="0,0,0,10" Background="#FFFFFF" BorderBrush="#CCCCCC" BorderThickness="1" Grid.Row="0">
            <DockPanel>
                <DockPanel Height="30" Margin="0,0,0,5" DockPanel.Dock="Top">
                    <Label Content="Show:" VerticalAlignment="Center" Margin="5,0"/>
                    <ComboBox Name="ShowComboBox" Width="100" HorizontalAlignment="Left" SelectedIndex="0" VerticalContentAlignment="Center" Margin="5,0,0,0" SelectionChanged="Show_Event">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="Todo"/>
                        <ComboBoxItem Content="Done"/>
                    </ComboBox>

                    <Button x:Name="DeleteAllBtn" Width="150" HorizontalAlignment="Right" Content="Delete all done" Margin="10,0,0,0" Background="#FF4CAF50" Foreground="White" FontWeight="Bold" Click="DeleteAllBtn_Click"/>
                </DockPanel>
                <ListView x:Name="PrimaryList" Background="White" BorderBrush="#CCCCCC" BorderThickness="1">
                    <ListView.Resources>
                        <Style TargetType="{x:Type ListViewItem}">
                            <EventSetter Event="Control.MouseDoubleClick" Handler="ListViewItem_MouseDoubleClick"/>
                        </Style>
                    </ListView.Resources>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Id" Width="35" DisplayMemberBinding="{Binding Id}"/>
                            <GridViewColumn Header="Task" Width="220" DisplayMemberBinding="{Binding Content}"/>
                            <GridViewColumn Header="Date of creation" Width="170" DisplayMemberBinding="{Binding Date}"/>
                            <GridViewColumn Header="Due to date" Width="170" DisplayMemberBinding="{Binding DueDate}"/>
                            <GridViewColumn Header="State" Width="150" DisplayMemberBinding="{Binding State}"/>
                        </GridView>
                    </ListView.View>

                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Označit jako Todo" Click="MarkAsTodo_Click"/>
                            <MenuItem Header="Označit jako Done" Click="MarkAsDone_Click"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                </ListView>
            </DockPanel>
        </GroupBox>

        <!-- Add Task -->
        <GroupBox Header="Add Task" Grid.Row="1">
            <StackPanel Margin="5">
                <DockPanel Height="26">
                    <TextBox x:Name="AddInput" Width="300" HorizontalAlignment="Left" Padding="3,0,0,0" VerticalContentAlignment="Center"/>
                    <DatePicker x:Name="DueDatePicker" Width="120" Margin="10,0,0,0" VerticalAlignment="Center"/>

                    <!-- ComboBox for hours -->
                    <ComboBox x:Name="HourComboBox" Width="60" Margin="5,0,0,0" VerticalAlignment="Center">
                        <ComboBoxItem Content="00"/>
                        <ComboBoxItem Content="01"/>
                        <ComboBoxItem Content="02"/>
                        <ComboBoxItem Content="03"/>
                        <ComboBoxItem Content="04"/>
                        <ComboBoxItem Content="05"/>
                        <ComboBoxItem Content="06"/>
                        <ComboBoxItem Content="07"/>
                        <ComboBoxItem Content="08"/>
                        <ComboBoxItem Content="09"/>
                        <ComboBoxItem Content="10"/>
                        <ComboBoxItem Content="11"/>
                        <ComboBoxItem Content="12"/>
                        <ComboBoxItem Content="13"/>
                        <ComboBoxItem Content="14"/>
                        <ComboBoxItem Content="15"/>
                        <ComboBoxItem Content="16"/>
                        <ComboBoxItem Content="17"/>
                        <ComboBoxItem Content="18"/>
                        <ComboBoxItem Content="19"/>
                        <ComboBoxItem Content="20"/>
                        <ComboBoxItem Content="21"/>
                        <ComboBoxItem Content="22"/>
                        <ComboBoxItem Content="23"/>
                    </ComboBox>

                    <!-- ComboBox for minutes -->
                    <ComboBox x:Name="MinuteComboBox" Width="60" Margin="5,0,0,0" VerticalAlignment="Center">
                        <ComboBoxItem Content="00"/>
                        <ComboBoxItem Content="01"/>
                        <ComboBoxItem Content="02"/>
                        <ComboBoxItem Content="03"/>
                        <ComboBoxItem Content="04"/>
                        <ComboBoxItem Content="05"/>
                        <ComboBoxItem Content="06"/>
                        <ComboBoxItem Content="07"/>
                        <ComboBoxItem Content="08"/>
                        <ComboBoxItem Content="09"/>
                        <ComboBoxItem Content="10"/>
                        <ComboBoxItem Content="11"/>
                        <ComboBoxItem Content="12"/>
                        <ComboBoxItem Content="13"/>
                        <ComboBoxItem Content="14"/>
                        <ComboBoxItem Content="15"/>
                        <ComboBoxItem Content="16"/>
                        <ComboBoxItem Content="17"/>
                        <ComboBoxItem Content="18"/>
                        <ComboBoxItem Content="19"/>
                        <ComboBoxItem Content="20"/>
                        <ComboBoxItem Content="21"/>
                        <ComboBoxItem Content="22"/>
                        <ComboBoxItem Content="23"/>
                    </ComboBox>

                    <Button x:Name="AddBtn" Width="100" HorizontalAlignment="Right" Content="Add" Click="AddBtn_Click"/>
                </DockPanel>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
